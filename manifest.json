{
  "manifest_version": 3,
  "name": "AI文档智写",
  "version": "2.2.0",
  "default_locale": "zh_CN",
  "description": "AI智能识别截图，一键生成文档，支持多格式导出",
  "icons": {
    "16": "images/icon-16.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
  "background": {
    "service_worker": "bundles/service-worker.min.js"
  },
  "action": {
    "default_title": "AI文档智写"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "bundles/zip-utils.min.js",
        "bundles/content.min.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": [
    "sidePanel",
    "downloads",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "editor.html",
        "bundles/editor.min.js",
        "bundles/docx.min.js",
        "bundles/pptx-export-v2.min.js",
        "bundles/pptxgen.bundle.min.js",
        "bundles/zhipu-vision.min.js",
        "bundles/zhipu-settings.min.js",
        "bundles/zhipu-recognize.min.js",
        "bundles/zhipu-export.min.js",
        "bundles/text-step.min.js",
        "settings.html",
        "bundles/settings.min.js",
        "prompts/*.txt"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}